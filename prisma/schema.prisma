// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VOLUNTEER
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(VOLUNTEER)
  phone        String?
  birthDate    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  enrollments  Enrollment[]

  @@index([role])
}

model Uniform {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Notice {
  id            String   @id @default(cuid())
  message       String
  author        String
  visibleFrom   DateTime
  visibleUntil  DateTime
  createdAt     DateTime @default(now())

  @@index([visibleFrom, visibleUntil])
}

model Event {
  id        String   @id @default(cuid())
  title     String
  startsAt  DateTime
  capacity  Int      @default(1)
  dressCode String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  slots       EventSlot[]

  @@index([startsAt])
}

model EventSlot {
  id       String  @id @default(cuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label    String
  location String?
  order    Int     @default(0)

  enrollments Enrollment[]

  @@index([eventId])
}

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slotId     String?
  slot       EventSlot?       @relation(fields: [slotId], references: [id], onDelete: SetNull)
  status     EnrollmentStatus @default(PENDING)
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, eventId])
  @@index([status])
}
